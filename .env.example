DATA_GO_KR_SERVICE_KEY=your-service-key-here

# 네이버 메일 기준 예시입니다. 네이버 메일 > 환경설정 > POP3/IMAP 설정에서
# SMTP 사용을 켜고, 2단계 인증을 쓰는 경우 앱 비밀번호를 발급받아
# SMTP_PASSWORD에 넣으세요 (계정 로그인 비밀번호가 아닙니다).
SMTP_HOST=smtp.naver.com
SMTP_PORT=587
SMTP_USERNAME=your-naver-id@naver.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-naver-id@naver.com
EMAIL_TO=your-naver-id@naver.com

REGION_FILTER="수원시 영통구,용인시 기흥구"
POLL_INTERVAL=6h
SEEN_DB_PATH=./seen.json
# true로 설정하면 무한 폴링 대신 한 번만 실행하고 종료합니다 (cron/GitHub Actions용).
RUN_ONCE=false
